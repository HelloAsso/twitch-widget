# Environnement : correspond au nom de la branche git ("main", "develop", etc.)
APP_ENV=develop

DBURL=localhost
DBPORT=3306
DBNAME=twitch
DBUSER=root
DBPASSWORD=
DBPREFIX=sandbox_
LOGLEVEL=DEBUG
# Sortie des logs : "file" (fichiers dans logs/, par défaut) ou "errorlog" (une ligne JSON par log
# via error_log(), pour Clever Cloud + drain Datadog)
LOG_OUTPUT=file
# Tags Datadog, facultatifs : par défaut service=twitch-widget, env=APP_ENV, version=APP_VERSION
#DD_SERVICE=twitch-widget
#DD_ENV=
#DD_VERSION=

BLOB_URL=
BLOB_CONNECTION_STRING=

HA_URL="https://www.helloasso-sandbox.com"
HA_AUTH_URL="https://auth.helloasso-sandbox.com"
API_AUTH_URL=https://api.helloasso-sandbox.com/oauth2/token
API_URL=https://api.helloasso-sandbox.com/v5
CLIENT_ID=
CLIENT_SECRET=

ENCRYPTION_KEY=
WEBSITE_DOMAIN=http://localhost:3000

# Emails transactionnels (Brevo, https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
# Optionnel : expéditeur (doit être un expéditeur/domaine validé dans Brevo)
MAIL_FROM_EMAIL=contact@helloasso.com
MAIL_FROM_NAME=HelloAsso
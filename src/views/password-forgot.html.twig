{% block title %}Mot de passe oublié · HelloAsso Stream{% endblock %}
{% extends "layout.html.twig" %}
{% block content %}
	<section class="container ha-auth-page">
		<div class="ha-auth-card">
			<h2>Mot de passe oublié</h2>
			<p class="mb-0">Indiquez l'email de votre compte : on vous envoie un lien pour choisir un nouveau mot de passe.</p>
			<form action="/forgot_password" method="POST">
				<div class="form-group">
					<label for="email">Email</label>
					<input type="email" class="form-control" id="email" name="email" autocomplete="email" required>
				</div>
				<button type="submit" class="btn btn-primary w-100 mt-2">Recevoir le lien</button>
			</form>
			<div class="ha-auth-card__links">
				<a href="/" class="ha-back-link">Retour à la connexion</a>
			</div>
		</div>
	</section>
{% endblock %}

{% block title %}Réinitialisation de mot de passe — HelloAsso Widgets{% endblock %}
{% extends "layout.html.twig" %}
{% block content %}
	<div class="auth-wrap">
		<div class="auth-card">
			<div class="auth-brand">
				<span class="brand-mark brand-mark--lg" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 21s-7.5-4.7-10-9.3C.4 8.6 2.3 5 5.7 5c2 0 3.4 1.1 4.3 2.4l2 2.8 2-2.8C15 6.1 16.3 5 18.3 5c3.4 0 5.3 3.6 3.7 6.7C19.5 16.3 12 21 12 21z"/></svg>
				</span>
				<span>HelloAsso&nbsp;<span class="text-gradient">Widgets</span></span>
			</div>
			<h1 class="auth-title">Nouveau mot de passe</h1>
			<p class="auth-sub">Choisissez un nouveau mot de passe pour votre compte.</p>
			<form action="/reset_password" method="POST">
				<input type="hidden" name="token" value="{{ token }}"/>
				<div class="mb-3">
					<label for="password" class="form-label">Mot de passe</label>
					<input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required autofocus>
				</div>
				<div class="mb-4">
					<label for="passwordRepeat" class="form-label">Confirmation de mot de passe</label>
					<input type="password" class="form-control" id="passwordRepeat" name="passwordRepeat" placeholder="••••••••" required>
				</div>
				<button type="submit" class="btn btn-primary btn-lg w-100">Définir mon mot de passe 🔑</button>
			</form>
		</div>
	</div>

	{% if messages['password_reset_error'] %}
		{% include '_toast.html.twig' with { tone: 'error', title: 'Échec', body: 'Erreur lors de la réinitilisation' } %}
	{% endif %}
{% endblock %}

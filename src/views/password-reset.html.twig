{% block title %}Nouveau mot de passe · HelloAsso Stream{% endblock %}
{% extends "layout.html.twig" %}
{% block content %}
	<section class="container ha-auth-page">
		<div class="ha-auth-card">
			<h2>Nouveau mot de passe</h2>
			<form action="/reset_password" method="POST">
				<input type="hidden" name="token" value="{{ token }}"/>
				<div class="form-group">
					<label for="password">Mot de passe</label>
					<input type="password" class="form-control" id="password" name="password" autocomplete="new-password" required>
				</div>
				<div class="form-group">
					<label for="passwordRepeat">Confirmation du mot de passe</label>
					<input type="password" class="form-control" id="passwordRepeat" name="passwordRepeat" autocomplete="new-password" required>
				</div>
				<button type="submit" class="btn btn-primary w-100 mt-2">Enregistrer mon mot de passe</button>
			</form>
		</div>
	</section>

	{% if messages['password_reset_error'] %}
		{% include '_toast.html.twig' with { title: 'Échec', body: 'Erreur lors de la réinitialisation du mot de passe.' } %}
	{% endif %}
{% endblock %}

{% block title %}Tableau de bord — HelloAsso Widgets{% endblock %}

{% extends "layout.html.twig" %}
{% block nav %}{% include '_navbar.html.twig' %}{% endblock %}
{% block content %}

		{# ── Modal création évènement ── #}
		<div class="modal fade" id="createEventModal" tabindex="-1">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<div class="d-flex align-items-center gap-2">
							<span class="section-ico">👐</span>
							<h5 class="modal-title">Créer un évènement</h5>
						</div>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						<form action="/admin/event" method="POST">
							<input type="hidden" name="owner_email" value="{{ currentUser.email }}">
							<div class="mb-4">
								<label for="event_title" class="form-label">Titre</label>
								<input type="text" class="form-control" id="event_title" name="title" placeholder="ex : Marathon caritatif 2026" required>
							</div>
							<div class="d-grid">
								<button type="submit" class="btn btn-primary" name="create_charity_event">Créer l'évènement</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>

		{# ── Modal création stream (même interface que l'admin, sans le champ email) ── #}
		{% include 'stream/_modal-create-stream.html.twig' with { isAdmin: false } %}

		<div class="container">
			<div class="page-head">
				<div>
					<h1 class="page-head__title">Tableau de bord</h1>
					<p class="page-head__sub">Gérez vos évènements, vos streams et leurs widgets.</p>
				</div>
				<div class="page-head__actions">
					<button type="button" class="btn btn-ghost" data-bs-toggle="modal" data-bs-target="#createEventModal">
						👐 Nouvel évènement
					</button>
					<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createStreamModal">
						🎮 Nouveau stream
					</button>
				</div>
			</div>

			{# ── Onboarding si aucun contenu ── #}
			{% if events is empty and streams is empty %}
				<div class="empty-state">
					<div class="empty-state__ico">🚀</div>
					<h2>Bienvenue sur HelloAsso Widgets !</h2>
					<p class="mb-4">
						Vous n'avez pas encore créé de stream ni d'évènement.
						Commencez dès maintenant en quelques clics !
					</p>
					<div class="d-flex justify-content-center flex-wrap gap-3">
						<button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#createEventModal">
							👐 Créer un évènement
						</button>
						<button type="button" class="btn btn-ghost btn-lg" data-bs-toggle="modal" data-bs-target="#createStreamModal">
							🎮 Créer un stream
						</button>
					</div>
				</div>
			{% else %}

			{% if events %}
				<div class="card mb-4">
					<div class="card-header">
						<div class="card-title-group">
							<span class="section-ico">📅</span>
							<h5>Évènements</h5>
							<span class="badge text-bg-secondary rounded-pill">{{ events|length }}</span>
						</div>
					</div>
					<div class="table-responsive">
						<table class="table table-hover align-middle">
							<thead>
								<tr>
									<th>Id</th>
									<th>Titre</th>
									<th>Date de création</th>
									<th class="text-end">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for event in events %}
									<tr class="cursor-pointer" onclick="window.location='/admin/event/{{ event.guid }}/edit'" title="GUID : {{ event.guid }}">
										<td class="cell-id">{{ event.id | e }}</td>
										<td class="cell-strong">{{ event.title | e }}</td>
										<td>{{ event.creation_date ? event.creation_date|date('d/m/Y H:i') : '—' }}</td>
										<td onclick="event.stopPropagation()">
											<div class="d-flex justify-content-end gap-2">
												<a href="/admin/event/{{ event.guid }}/edit" class="btn btn-icon btn-outline-primary" data-bs-toggle="tooltip" data-bs-title="Édition">📝</a>
												<form action="/admin/event/{{ event.guid }}/delete" method="POST">
													<button type="submit" class="btn btn-icon btn-outline-danger" name="delete" data-bs-toggle="tooltip" data-bs-title="Suppression" onclick="confirmDelete(event)">🗑️</button>
												</form>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			{% endif %}

			<div class="card mb-4">
				<div class="card-header">
					<div class="card-title-group">
						<span class="section-ico">🎮</span>
						<h5>Streams</h5>
						<span class="badge text-bg-secondary rounded-pill">{{ streams|length }}</span>
					</div>
				</div>
				<div class="table-responsive">
					<table class="table table-hover align-middle">
						<thead>
							<tr>
								<th>Id</th>
								<th>Titre</th>
								<th>Slug formulaire</th>
								<th>Slug association</th>
								<th class="text-end">Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for stream in streams %}
								<tr class="cursor-pointer" onclick="window.location='/admin/stream/{{ stream.guid }}/edit'" title="GUID : {{ stream.guid }}">
									<td class="cell-id">{{ stream.id | e }}</td>
									<td class="cell-strong">
										{{ stream.title | e }}
										{% if stream.organization_slug in invalidTokenSlugs %}
											<span class="badge text-bg-warning ms-1" data-bs-toggle="tooltip" data-bs-title="Refresh token expiré ou absent — les widgets ne fonctionneront pas. Reconnectez l'association.">⚠️ Token invalide</span>
										{% endif %}
									</td>
									<td>{{ stream.form_slug | e }}</td>
									<td>{{ stream.organization_slug | e }}</td>
									<td onclick="event.stopPropagation()">
										<div class="d-flex justify-content-end gap-2">
											<a href="/admin/stream/{{ stream.guid }}/edit" class="btn btn-icon btn-outline-primary" data-bs-toggle="tooltip" data-bs-title="Édition">📝</a>
											<a href="/redirect_auth_page?organizationSlug={{ stream.organization_slug }}" class="btn btn-icon btn-outline-success" data-bs-toggle="tooltip" data-bs-title="Mire d'authorisation" target="_blank">🔑</a>
											<form action="/admin/stream/{{ stream.guid }}/delete" method="POST">
												<button type="submit" class="btn btn-icon btn-outline-danger" name="delete" data-bs-toggle="tooltip" data-bs-title="Suppression" onclick="confirmDelete(event)">🗑️</button>
											</form>
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>

			{% endif %}{# /onboarding #}
		</div>

	{% if messages['error'] %}
		{% include '_toast.html.twig' with { tone: 'error', title: 'Erreur', body: messages['error'][0] } %}
	{% endif %}

	{% if messages['success'] %}
		{% include '_toast.html.twig' with { tone: 'success', title: 'Ok', body: messages['success'][0] } %}
	{% endif %}
{% endblock %}
{% block scripts %}
	{% include 'stream/_scripts-create-stream.html.twig' %}
{% endblock %}

{% block title %}Tableau de bord · HelloAsso Stream{% endblock %}

{% extends "layout.html.twig" %}
{% block content %}

		{% include 'stream/_modal-create-event.html.twig' with { isAdmin: false } %}

		{# ── Modale de création de stream (même interface que l'admin, sans le champ email) ── #}
		{% include 'stream/_modal-create-stream.html.twig' with { isAdmin: false } %}

		<div class="container">
			<div class="ha-page-head">
				<div class="ha-page-head__title">
					<span class="ha-eyebrow">Tableau de bord</span>
					<h1>Mes lives caritatifs</h1>
				</div>
				{% if events is not empty or streams is not empty %}
					<div class="ha-page-head__actions">
						<button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#createEventModal">
							Ajouter un événement
						</button>
						<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createStreamModal">
							Ajouter un stream
						</button>
					</div>
				{% endif %}
			</div>

			{% if events is empty and streams is empty %}
				{# ── Premiers pas : rien n'a encore été créé ── #}
				<div class="ha-onboarding">
					<section aria-labelledby="nextStepsTitle">
						<h2 id="nextStepsTitle" class="h3 mb-3">Vos prochaines étapes</h2>
						<p class="ha-lead mb-5">
							Votre espace est prêt. Quatre étapes vous séparent de votre premier live caritatif.
							Le <a href="{{ helpCenterUrl }}" target="_blank" rel="noopener">centre d'aide</a> les détaille pas à pas.
						</p>
						<ol class="ha-onboarding__steps">
							<li class="ha-onboarding__step">
								<h3>Créez votre premier stream</h3>
								<p>Reliez votre formulaire de don ou votre campagne de crowdfunding HelloAsso : le stream récupère ses dons en temps réel.</p>
								<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createStreamModal">
									Créer mon premier stream
								</button>
							</li>
							<li class="ha-onboarding__step">
								<h3>Fixez vos objectifs</h3>
								<p>Ajoutez un ou plusieurs paliers (500 €, 1 000 €…). La barre de don avance vers chacun d'eux et célèbre chaque palier atteint.</p>
							</li>
							<li class="ha-onboarding__step">
								<h3>Personnalisez vos widgets</h3>
								<p>Carte de don, barre de progression et alerte à chaque don : choisissez couleurs, textes, image et son.</p>
							</li>
							<li class="ha-onboarding__step">
								<h3>Ajoutez-les dans OBS et testez</h3>
								<p>Collez l'adresse de chaque widget dans OBS ou Streamlabs, puis simulez des dons avec le mode test avant le live.</p>
							</li>
						</ol>
					</section>

					<section aria-labelledby="streamVsEventTitle">
						<h2 id="streamVsEventTitle" class="h3 mb-3">Stream ou événement ?</h2>
						<p class="ha-lead mb-5">Commencez toujours par un stream. L'événement ne sert que si plusieurs lives collectent pour la même cause.</p>
						<div class="ha-onboarding__compare">
							<article class="ha-onboarding__concept">
								<span class="ha-eyebrow">Le point de départ</span>
								<h3>Le stream</h3>
								<ul>
									<li>Relié à un formulaire de don ou à une campagne de crowdfunding de votre association.</li>
									<li>Récupère les dons de ce formulaire en temps réel.</li>
									<li>Fournit trois widgets à afficher en live : carte de don, barre de don et alerte à chaque don.</li>
									<li>Un streamer, un live : c'est le cas le plus courant.</li>
								</ul>
								<button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#createStreamModal">
									Créer un stream
								</button>
							</article>
							<article class="ha-onboarding__concept">
								<span class="ha-eyebrow">Plusieurs streams réunis</span>
								<h3>L'événement</h3>
								<ul>
									<li>Regroupe les streams de plusieurs streamers qui collectent pour la même cause.</li>
									<li>Additionne les dons de tous ses streams dans un seul compteur.</li>
									<li>A ses propres objectifs, sa barre de don et sa carte de don.</li>
									<li>Facultatif : inutile si vous organisez un seul live.</li>
								</ul>
								<button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#createEventModal">
									Créer un événement
								</button>
							</article>
						</div>
					</section>
				</div>
			{% else %}

			{% if events %}
				<section class="mb-5">
					<h2 class="ha-section-title mb-3">Événements</h2>
					<div class="ha-table-wrap">
						<table class="table table-hover align-middle">
							<thead>
								<tr>
									<th>Id</th>
									<th>Titre</th>
									<th>Date de création</th>
									<th class="text-end">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for event in events %}
									<tr class="cursor-pointer" onclick="window.location='/admin/event/{{ event.guid }}/edit'" title="GUID : {{ event.guid }}">
										<td>{{ event.id | e }}</td>
										<td>{{ event.title | e }}</td>
										<td>{{ event.creation_date ? event.creation_date|date('d/m/Y H:i') : '—' }}</td>
										<td onclick="event.stopPropagation()">
											<div class="d-flex justify-content-end gap-2">
												<a href="/admin/event/{{ event.guid }}/edit" class="btn btn-sm btn-secondary">Modifier</a>
												<form action="/admin/event/{{ event.guid }}/delete" method="POST">
													<button type="submit" class="btn btn-sm btn-outline-danger" name="delete" onclick="confirmDelete(event)">Supprimer</button>
												</form>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</section>
			{% endif %}

			<section>
				<h2 class="ha-section-title mb-3">Streams</h2>
				{% if streams is empty %}
					<div class="ha-empty">
						<p class="ha-empty__title">Aucun stream pour l'instant</p>
						<p class="mb-3">Un stream relie un formulaire HelloAsso à vos widgets de live.</p>
						<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createStreamModal">Créer un stream</button>
					</div>
				{% else %}
				<div class="ha-table-wrap">
					<table class="table table-hover align-middle">
						<thead>
							<tr>
								<th>Id</th>
								<th>Titre</th>
								<th>Slug formulaire</th>
								<th>Slug association</th>
								<th class="text-end">Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for stream in streams %}
								<tr class="cursor-pointer" onclick="window.location='/admin/stream/{{ stream.guid }}/edit'" title="GUID : {{ stream.guid }}">
									<td>{{ stream.id | e }}</td>
									<td>
										{{ stream.title | e }}
										{% if stream.organization_slug in invalidTokenSlugs %}
											<span class="badge text-bg-warning ms-1" data-bs-toggle="tooltip" data-bs-title="Autorisation de l'association expirée ou absente : les widgets ne fonctionneront pas. Renouvelez-la avec le bouton Autoriser.">Token invalide</span>
										{% endif %}
									</td>
									<td>{{ stream.form_slug | e }}</td>
									<td>{{ stream.organization_slug | e }}</td>
									<td onclick="event.stopPropagation()">
										<div class="d-flex justify-content-end gap-2">
											<a href="/admin/stream/{{ stream.guid }}/edit" class="btn btn-sm btn-secondary">Modifier</a>
											<a href="/redirect_auth_page?organizationSlug={{ stream.organization_slug }}" class="btn btn-sm btn-secondary" data-bs-toggle="tooltip" data-bs-title="Lien d'autorisation à envoyer à un administrateur de l'association" target="_blank">Autoriser</a>
											<form action="/admin/stream/{{ stream.guid }}/delete" method="POST">
												<button type="submit" class="btn btn-sm btn-outline-danger" name="delete" onclick="confirmDelete(event)">Supprimer</button>
											</form>
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				{% endif %}
			</section>

			{% endif %}{# /premiers pas #}
		</div>

	{% if messages['error'] %}
		{% include '_toast.html.twig' with { type: 'error', title: 'Erreur', body: messages['error'][0] } %}
	{% endif %}

	{% if messages['success'] %}
		{% include '_toast.html.twig' with { title: 'C\'est fait', body: messages['success'][0] } %}
	{% endif %}
{% endblock %}
{% block scripts %}
	{% include 'stream/_scripts-create-stream.html.twig' %}
{% endblock %}

{% block title %}Administration · HelloAsso Stream{% endblock %}

{% extends "layout.html.twig" %}
{% block content %}

		{% include 'stream/_modal-create-event.html.twig' with { isAdmin: true } %}

		{# ── Modale de création d'utilisateur ── #}
		<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalTitle">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h2 class="modal-title" id="createUserModalTitle">Nouvel utilisateur</h2>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
					</div>
					<div class="modal-body">
						<form action="/admin/user" method="POST" class="d-flex flex-column gap-3">
							<div>
								<label for="user_email" class="form-label">Email</label>
								<input type="email" class="form-control" id="user_email" name="user_email" placeholder="utilisateur@exemple.com" required>
								<div class="form-text">Un email de bienvenue lui sera envoyé avec un lien pour choisir son mot de passe.</div>
							</div>
							<button type="submit" class="btn btn-primary align-self-start">Créer l'utilisateur</button>
						</form>
					</div>
				</div>
			</div>
		</div>

	{% include 'stream/_modal-create-stream.html.twig' with { isAdmin: true } %}

		<div class="container">
			<div class="ha-page-head">
				<div class="ha-page-head__title">
					<span class="ha-eyebrow">Administration</span>
					<h1>Tous les lives</h1>
				</div>
				<div class="ha-page-head__actions">
					<button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#createUserModal">
						Ajouter un utilisateur
					</button>
					<button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#createEventModal">
						Ajouter un événement
					</button>
					<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createStreamModal">
						Ajouter un stream
					</button>
				</div>
			</div>

			{# ── Onglets ── #}
			<ul class="nav nav-tabs mb-4" id="adminTabs" role="tablist">
				<li class="nav-item" role="presentation">
					<button class="nav-link {{ activeTab == 'events' ? 'active' : '' }}" id="events-tab" data-bs-toggle="tab" data-bs-target="#events-pane" type="button" role="tab" aria-controls="events-pane" aria-selected="{{ activeTab == 'events' ? 'true' : 'false' }}">
						Événements <span class="badge text-bg-secondary">{{ events|length }}</span>
					</button>
				</li>
				<li class="nav-item" role="presentation">
					<button class="nav-link {{ activeTab == 'streams' ? 'active' : '' }}" id="streams-tab" data-bs-toggle="tab" data-bs-target="#streams-pane" type="button" role="tab" aria-controls="streams-pane" aria-selected="{{ activeTab == 'streams' ? 'true' : 'false' }}">
						Streams <span class="badge text-bg-secondary">{{ streams|length }}</span>
					</button>
				</li>
				{% if users is defined %}
				<li class="nav-item" role="presentation">
					<button class="nav-link {{ activeTab == 'users' ? 'active' : '' }}" id="users-tab" data-bs-toggle="tab" data-bs-target="#users-pane" type="button" role="tab" aria-controls="users-pane" aria-selected="{{ activeTab == 'users' ? 'true' : 'false' }}">
						Utilisateurs <span class="badge text-bg-secondary">{{ users|length }}</span>
					</button>
				</li>
				{% endif %}
			</ul>

			<div class="tab-content" id="adminTabsContent">
				{# ── Onglet Événements ── #}
				<div class="tab-pane fade {{ activeTab == 'events' ? 'show active' : '' }}" id="events-pane" role="tabpanel" aria-labelledby="events-tab">
					<div class="ha-table-wrap">
						<table class="table table-hover align-middle">
							<thead>
								<tr>
									<th>Id</th>
									<th>Titre</th>
									<th>Admin</th>
									<th>Date de création</th>
									<th class="text-end">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for event in events %}
									<tr class="cursor-pointer" onclick="window.location='/admin/event/{{ event.guid }}/edit'" title="GUID : {{ event.guid }}">
										<td>{{ event.id | e }}</td>
										<td>{{ event.title | e }}</td>
										<td>{{ event.admin | e }}</td>
										<td>{{ event.creation_date ? event.creation_date|date('d/m/Y H:i') : '—' }}</td>
										<td onclick="event.stopPropagation()">
											<div class="d-flex justify-content-end gap-2">
												<a href="/admin/event/{{ event.guid }}/edit" class="btn btn-sm btn-secondary">Modifier</a>
												<form action="/admin/event/{{ event.guid }}/delete" method="POST">
													<button type="submit" class="btn btn-sm btn-outline-danger" name="delete" onclick="confirmDelete(event)">Supprimer</button>
												</form>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>

				{# ── Onglet Streams ── #}
				<div class="tab-pane fade {{ activeTab == 'streams' ? 'show active' : '' }}" id="streams-pane" role="tabpanel" aria-labelledby="streams-tab">
					<div class="ha-table-wrap">
						<table class="table table-hover align-middle">
							<thead>
								<tr>
									<th>ID</th>
									<th>Titre</th>
									<th>Activité</th>
									<th>Admin</th>
									<th>Slug formulaire</th>
									<th>Slug association</th>
									<th>Date de création</th>
									<th class="text-end">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for stream in streams %}
									{% set activity = streamActivity[stream.guid] ?? null %}
									{% set amount = activity ? activity.amount : 0 %}
									{% set widgetLastUpdate = activity ? activity.widget_last_update : null %}
									<tr class="cursor-pointer" onclick="window.location='/admin/stream/{{ stream.guid }}/edit'" title="GUID : {{ stream.guid }}">
										<td>{{ stream.id | e }}</td>
										<td>
											{{ stream.title | e }}
											{% if stream.organization_slug in invalidTokenSlugs %}
												<span class="badge text-bg-warning ms-1" data-bs-toggle="tooltip" data-bs-title="Autorisation de l'association expirée ou absente : les widgets ne fonctionneront pas. Renouvelez-la avec le bouton Autoriser.">Token invalide</span>
											{% endif %}
										</td>
										<td>
											{% if widgetLastUpdate and (date(widgetLastUpdate).timestamp > date('-5 minutes').timestamp) %}
												<span class="badge text-bg-success" data-bs-toggle="tooltip" data-bs-title="Widget consulté il y a moins de 5 min">En direct</span>
											{% elseif amount > 0 %}
												<span class="badge text-bg-info" data-bs-toggle="tooltip" data-bs-title="Dernière activité : {{ widgetLastUpdate ? widgetLastUpdate|date('d/m/Y H:i') : '—' }}">{{ (amount / 100)|number_format(0, ',', ' ') }} €</span>
											{% else %}
												<span class="badge text-bg-secondary">Inactif</span>
											{% endif %}
										</td>
										<td>{{ stream.admin | e }}</td>
										<td>{{ stream.form_slug | e }}</td>
										<td>{{ stream.organization_slug | e }}</td>
										<td>{{ stream.creation_date ? stream.creation_date|date('d/m/Y H:i') : '—' }}</td>
										<td onclick="event.stopPropagation()">
											<div class="d-flex justify-content-end gap-2">
												<a href="/admin/stream/{{ stream.guid }}/edit" class="btn btn-sm btn-secondary">Modifier</a>
												<a href="/redirect_auth_page?organizationSlug={{ stream.organization_slug }}" class="btn btn-sm btn-secondary" data-bs-toggle="tooltip" data-bs-title="Lien d'autorisation à envoyer à un administrateur de l'association" target="_blank">Autoriser</a>
												<form action="/admin/stream/{{ stream.guid }}/delete" method="POST">
													<button type="submit" class="btn btn-sm btn-outline-danger" name="delete" onclick="confirmDelete(event)">Supprimer</button>
												</form>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>

				{# ── Onglet Utilisateurs ── #}
				{% if users is defined %}
				<div class="tab-pane fade {{ activeTab == 'users' ? 'show active' : '' }}" id="users-pane" role="tabpanel" aria-labelledby="users-tab">
					<div class="ha-table-wrap">
						<table class="table table-hover align-middle">
							<thead>
								<tr>
									<th>ID</th>
									<th>Email</th>
									<th>Rôle</th>
									<th>Email vérifié</th>
									<th>Date de création</th>
									<th class="text-end">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for u in users %}
									<tr>
										<td>{{ u.id }}</td>
										<td>{{ u.email | e }}</td>
										<td>
											{% if u.role == 'ADMIN' %}
												<span class="badge text-bg-danger">Admin</span>
											{% else %}
												<span class="badge text-bg-secondary">Utilisateur</span>
											{% endif %}
										</td>
										<td>
											{% if u.email_verified %}
												<span class="badge text-bg-success">Vérifié</span>
											{% else %}
												<span class="badge text-bg-warning">Non vérifié</span>
											{% endif %}
										</td>
										<td>{{ u.creation_date ? u.creation_date|date('d/m/Y H:i') : '—' }}</td>
										<td>
											{% if u.id != currentUser.id %}
												<form action="/admin/user/{{ u.id }}/delete" method="POST" class="d-flex justify-content-end">
													<button type="submit" class="btn btn-sm btn-outline-danger" onclick="confirmDelete(event)">Supprimer</button>
												</form>
											{% endif %}
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
				{% endif %}
			</div>
		</div>

	{% if messages['error'] %}
		{% include '_toast.html.twig' with { type: 'error', title: 'Erreur', body: messages['error'][0] } %}
	{% endif %}

	{% if messages['success'] %}
		{% include '_toast.html.twig' with { title: 'C\'est fait', body: messages['success'][0] } %}
	{% endif %}
{% endblock %}
{% block scripts %}
	{% include 'stream/_scripts-create-stream.html.twig' %}
{% endblock %}

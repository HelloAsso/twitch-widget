{% block title %}Connexion — HelloAsso Widgets{% endblock %}
{% extends "layout.html.twig" %}
{% block content %}
	<div class="auth-wrap">
		<div class="auth-card">
			<div class="auth-brand">
				<span class="brand-mark brand-mark--lg" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 21s-7.5-4.7-10-9.3C.4 8.6 2.3 5 5.7 5c2 0 3.4 1.1 4.3 2.4l2 2.8 2-2.8C15 6.1 16.3 5 18.3 5c3.4 0 5.3 3.6 3.7 6.7C19.5 16.3 12 21 12 21z"/></svg>
				</span>
				<span>HelloAsso&nbsp;<span class="text-gradient">Widgets</span></span>
			</div>
			<h1 class="auth-title">Bon retour 👋</h1>
			<p class="auth-sub">Connectez-vous pour gérer vos widgets de stream caritatif.</p>
			<form action="/login" method="POST">
				<div class="mb-3">
					<label for="email" class="form-label">Email</label>
					<input type="email" class="form-control" id="email" name="email" placeholder="vous@exemple.com" required autofocus>
				</div>
				<div class="mb-2">
					<label for="password" class="form-label">Mot de passe</label>
					<input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
				</div>
				<div class="text-end mb-4">
					<a href="/forgot_password" class="small">Mot de passe oublié ?</a>
				</div>
				<button type="submit" class="btn btn-primary btn-lg w-100">Se connecter</button>
				<p class="auth-alt">Pas encore de compte ? <a href="/register">Créer un compte</a></p>
			</form>
		</div>
	</div>

	{% if login_failed %}
		{% include '_toast.html.twig' with { tone: 'error', title: 'Erreur', body: 'Email ou mot de passe invalide 😞' } %}
	{% endif %}

	{% if mail_sent %}
		{% include '_toast.html.twig' with { tone: 'success', title: 'Mail envoyé', body: "Si un compte existe, un email de réinitilisation de mot de passe vient d'être envoyé" } %}
	{% endif %}

	{% if password_reset %}
		{% include '_toast.html.twig' with { tone: 'success', title: 'Mot de passe réinitialisé', body: 'Vous pouvez vous connecter 💪' } %}
	{% endif %}

	{% if register_success %}
		{% include '_toast.html.twig' with { tone: 'success', title: 'Inscription réussie', body: 'Un email de vérification vient de vous être envoyé 📧 Consultez votre boîte mail pour activer votre compte.' } %}
	{% endif %}

	{% if email_verified %}
		{% include '_toast.html.twig' with { tone: 'success', title: 'Email vérifié', body: 'Votre email a été confirmé, vous pouvez vous connecter 🎉' } %}
	{% endif %}

	{% if email_verify_error %}
		{% include '_toast.html.twig' with { tone: 'error', title: 'Erreur', body: 'Le lien de vérification est invalide ou a expiré 😞' } %}
	{% endif %}

	{% if email_not_verified %}
		{% include '_toast.html.twig' with { tone: 'error', title: 'Email non vérifié', body: "Votre adresse email n'est pas encore vérifiée. Un nouvel email de vérification vient de vous être envoyé 📧" } %}
	{% endif %}
{% endblock %}
{% block scripts %}
{% endblock %}

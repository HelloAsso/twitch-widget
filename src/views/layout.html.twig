<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}HelloAsso Widgets{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
    {% if appCss %}
    <link rel="stylesheet" href="/dist/{{ appCss }}">
    {% endif %}
    {% if appJs %}
    <script type="module" src="/dist/{{ appJs }}"></script>
    {% endif %}
    {% block scripts %}{% endblock %}
    {% block styles %}{% endblock %}
  </head>
  <body class="app-body">
    {% block nav %}{% endblock %}
    <main class="app-main">
      {% block content %}{% endblock %}
    </main>
    <footer class="app-footer">
      Fait avec ♥ par HelloAsso{% if appVersion %} &mdash; <span title="{{ appVersion }}">{{ appVersion|slice(0, 7) }}</span>{% endif %}
    </footer>
  </body>
</html>

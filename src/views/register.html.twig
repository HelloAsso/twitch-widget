{% block title %}Créer un compte — HelloAsso Widgets{% endblock %}
{% extends "layout.html.twig" %}
{% block content %}
	<div class="auth-wrap">
		<div class="auth-card">
			<div class="auth-brand">
				<span class="brand-mark brand-mark--lg" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 21s-7.5-4.7-10-9.3C.4 8.6 2.3 5 5.7 5c2 0 3.4 1.1 4.3 2.4l2 2.8 2-2.8C15 6.1 16.3 5 18.3 5c3.4 0 5.3 3.6 3.7 6.7C19.5 16.3 12 21 12 21z"/></svg>
				</span>
				<span>HelloAsso&nbsp;<span class="text-gradient">Widgets</span></span>
			</div>
			<h1 class="auth-title">Créer un compte</h1>
			<p class="auth-sub">Quelques secondes suffisent pour lancer vos premiers widgets.</p>
			<form action="/register" method="POST" id="registerForm" novalidate>
				<div class="mb-3">
					<label for="email" class="form-label">Email</label>
					<input type="email" class="form-control" id="email" name="email" placeholder="vous@exemple.com" required autofocus>
				</div>
				<div class="mb-3">
					<label for="password" class="form-label">Mot de passe</label>
					<input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required
						oninput="checkPasswordStrength()">
					<div class="mt-2" id="passwordRules">
						<small id="rule-length" class="text-danger d-block">✗ Au moins 8 caractères</small>
						<small id="rule-upper" class="text-danger d-block">✗ Au moins une majuscule</small>
						<small id="rule-lower" class="text-danger d-block">✗ Au moins une minuscule</small>
						<small id="rule-digit" class="text-danger d-block">✗ Au moins un chiffre</small>
						<small id="rule-special" class="text-danger d-block">✗ Au moins un caractère spécial</small>
					</div>
				</div>
				<div class="mb-4">
					<label for="passwordRepeat" class="form-label">Confirmer le mot de passe</label>
					<input type="password" class="form-control" id="passwordRepeat" name="passwordRepeat" placeholder="••••••••" required
						oninput="checkPasswordMatch()">
					<small id="rule-match" class="text-danger d-block mt-1" style="display:none !important;"></small>
				</div>
				<button type="submit" class="btn btn-primary btn-lg w-100" id="submitBtn" disabled>
					Créer mon compte 🚀
				</button>
				<p class="auth-alt">Déjà un compte ? <a href="/">Se connecter</a></p>
			</form>
		</div>
	</div>

	{% if register_error %}
		{% include '_toast.html.twig' with { tone: 'error', title: 'Erreur', body: register_error } %}
	{% endif %}
{% endblock %}

{% block scripts %}
<script>
	document.addEventListener('DOMContentLoaded', function() {
		var toastEl = document.getElementById('liveToast');
		if (toastEl) { new bootstrap.Toast(toastEl).show(); }
	});

	function checkPasswordStrength() {
		var pw = document.getElementById('password').value;
		setRule('rule-length', pw.length >= 8);
		setRule('rule-upper', /[A-Z]/.test(pw));
		setRule('rule-lower', /[a-z]/.test(pw));
		setRule('rule-digit', /[0-9]/.test(pw));
		setRule('rule-special', /[^A-Za-z0-9]/.test(pw));
		checkPasswordMatch();
		updateSubmitBtn();
	}

	function checkPasswordMatch() {
		var pw = document.getElementById('password').value;
		var pw2 = document.getElementById('passwordRepeat').value;
		var el = document.getElementById('rule-match');
		if (pw2.length === 0) {
			el.style.display = 'none';
		} else if (pw === pw2) {
			el.style.display = 'block';
			el.className = 'text-success d-block mt-1';
			el.textContent = '✓ Les mots de passe correspondent';
		} else {
			el.style.display = 'block';
			el.className = 'text-danger d-block mt-1';
			el.textContent = '✗ Les mots de passe ne correspondent pas';
		}
		updateSubmitBtn();
	}

	function setRule(id, valid) {
		var el = document.getElementById(id);
		if (valid) {
			el.className = 'text-success d-block';
			el.textContent = '✓' + el.textContent.substring(1);
		} else {
			el.className = 'text-danger d-block';
			el.textContent = '✗' + el.textContent.substring(1);
		}
	}

	function updateSubmitBtn() {
		var pw = document.getElementById('password').value;
		var pw2 = document.getElementById('passwordRepeat').value;
		var valid = pw.length >= 8
			&& /[A-Z]/.test(pw)
			&& /[a-z]/.test(pw)
			&& /[0-9]/.test(pw)
			&& /[^A-Za-z0-9]/.test(pw)
			&& pw === pw2
			&& pw2.length > 0;
		document.getElementById('submitBtn').disabled = !valid;
	}
</script>
{% endblock %}

{% block title %}Créer un compte · HelloAsso Stream{% endblock %}
{% extends "layout.html.twig" %}
{% block content %}
	<section class="container ha-auth-page">
		<div class="ha-auth-card">
			<span class="ha-eyebrow">Espace associations</span>
			<h2>Créer un compte</h2>
			<form action="/register" method="POST" id="registerForm" novalidate>
				<div class="form-group">
					<label for="email">Email</label>
					<input type="email" class="form-control" id="email" name="email" placeholder="vous@exemple.com" autocomplete="email" required>
				</div>
				<div class="form-group">
					<label for="password">Mot de passe</label>
					<input type="password" class="form-control" id="password" name="password" autocomplete="new-password" required
						oninput="checkPasswordStrength()" aria-describedby="passwordRules">
					<ul class="ha-rules" id="passwordRules">
						<li id="rule-length">Au moins 8 caractères</li>
						<li id="rule-upper">Au moins une majuscule</li>
						<li id="rule-lower">Au moins une minuscule</li>
						<li id="rule-digit">Au moins un chiffre</li>
						<li id="rule-special">Au moins un caractère spécial</li>
					</ul>
				</div>
				<div class="form-group">
					<label for="passwordRepeat">Confirmer le mot de passe</label>
					<input type="password" class="form-control" id="passwordRepeat" name="passwordRepeat" autocomplete="new-password" required
						oninput="checkPasswordMatch()">
					<p id="rule-match" class="ha-match mb-0" aria-live="polite" hidden></p>
				</div>
				<button type="submit" class="btn btn-primary w-100 mt-2" id="submitBtn" disabled>
					Créer mon compte
				</button>
			</form>
			<div class="ha-auth-card__links">
				<span>Déjà un compte ?</span>
				<a href="/" class="btn btn-secondary w-100">Se connecter</a>
			</div>
		</div>
	</section>

	{% if register_error %}
		{% include '_toast.html.twig' with { title: 'Erreur', body: register_error } %}
	{% endif %}
{% endblock %}

{% block scripts %}
<script>
	function checkPasswordStrength() {
		var pw = document.getElementById('password').value;
		setRule('rule-length', pw.length >= 8);
		setRule('rule-upper', /[A-Z]/.test(pw));
		setRule('rule-lower', /[a-z]/.test(pw));
		setRule('rule-digit', /[0-9]/.test(pw));
		setRule('rule-special', /[^A-Za-z0-9]/.test(pw));
		checkPasswordMatch();
		updateSubmitBtn();
	}

	function checkPasswordMatch() {
		var pw = document.getElementById('password').value;
		var pw2 = document.getElementById('passwordRepeat').value;
		var el = document.getElementById('rule-match');
		if (pw2.length === 0) {
			el.hidden = true;
		} else {
			el.hidden = false;
			el.textContent = pw === pw2
				? 'Les mots de passe correspondent.'
				: 'Les mots de passe ne correspondent pas.';
		}
		updateSubmitBtn();
	}

	function setRule(id, valid) {
		document.getElementById(id).classList.toggle('is-valid', valid);
	}

	function updateSubmitBtn() {
		var pw = document.getElementById('password').value;
		var pw2 = document.getElementById('passwordRepeat').value;
		var valid = pw.length >= 8
			&& /[A-Z]/.test(pw)
			&& /[a-z]/.test(pw)
			&& /[0-9]/.test(pw)
			&& /[^A-Za-z0-9]/.test(pw)
			&& pw === pw2
			&& pw2.length > 0;
		document.getElementById('submitBtn').disabled = !valid;
	}
</script>
{% endblock %}
